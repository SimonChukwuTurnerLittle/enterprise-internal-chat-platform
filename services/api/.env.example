# Copy to .env for running the API on your machine (uv run uvicorn ...).
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:5173

OIDC_ISSUER=http://localhost:8180/realms/enterprise
OIDC_CLIENT_ID=chat-platform
OIDC_CLIENT_SECRET=dev-chat-platform-secret
OIDC_AUDIENCE=chat-platform
OIDC_ROLES_CLAIM=realm_access.roles

# mock | openai | azure_openai
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_CHAT_DEPLOYMENT=...
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=...

ORGANISATION_NAME=Example Corp
